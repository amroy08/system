NODE_ENV=production
PORT=5050
APP_URL=https://school.example.com
CORS_ORIGINS=https://school.example.com
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
SESSION_HOURS=12

DB_DRIVER=mongo
MONGO_URI=mongodb+srv://replace-with-production-connection
MONGO_DB_NAME=mvhs_production
DATA_DIR=/var/lib/mvhs/data

STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=replace-with-private-document-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_BUCKET=replace-with-independent-backup-bucket
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_PREFIX=school-backups

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
EMAIL_FROM="M.V HIGH SCHOOL <noreply@school.example.com>"
